@using BIOLIFE.Models;
@using BIOLIFE.Utilities;
@model List<CategoryModel>
@inject IConfiguration Configuration
@{
    var i = 0;
    var link = "https://static-image.adavigo.com";
}
@if (Model != null)
{
    

    @foreach (var item in Model)
    {
        if (i == 0)
        {
            if (item.group_product_child != null && item.group_product_child.Count > 0)
            {
                <div class="omori-item list-product-name active" data-GroupProductId="@item.group_product_child[0].parentid">
                    <a href="san-pham?group_id=@item.group_product_child[0].parentid">
                        <img src="@link@item.imagepath" alt="OMORI Luxury">
                        <p>@item.name</p>
                    </a>
                </div>
              
            }
            else
            {
                    <div class="omori-item list-product-name active" data-GroupProductId="@item.id">
                    <a href="san-pham?group_id=@item.id">
                        <img src="@link@item.imagepath" alt="OMORI Luxury">
                            <p>@item.name</p>
                        </a>
                    </div>
               
            }

        }
        else
        {
            if (item.group_product_child != null && item.group_product_child.Count > 0)
            {
                <div class="omori-item list-product-name" data-GroupProductId="@item.group_product_child[0].parentid">
                    <a href="san-pham?group_id=@item.group_product_child[0].parentid">
                        <img src="@link@item.imagepath" alt="OMORI Luxury">
                            <p>@item.name</p>
                        </a>
                    </div>
            }
            else
            {
                    <div class="omori-item list-product-name" data-GroupProductId="@item.id">
                    <a href="san-pham?group_id=@item.id">
                        <img src="@link@item.imagepath" alt="OMORI Luxury">
                            <p>@item.name</p>
                        </a>
                    </div>
               
            }
        }

    }
}
